# ==============================================================================
# MIND CRAFT ARENA - FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# Backend API Base URL (REQUIRED)
# In development (connect to local backend):
VITE_API_URL=http://localhost:5000/api

# In production (set in Vercel Project Settings -> Environment Variables):
# Example: VITE_API_URL=https://your-backend.railway.app/api
# Or:      VITE_API_URL=https://your-backend.onrender.com/api

# Optional: Real Judge0 instance URL
VITE_JUDGE0_URL=https://judge0.adfuturestack.dev

# Audio sound effects toggle (true / false)
VITE_ENABLE_SOUNDS=true

# Mock judge toggle ('true' will evaluate locally, 'false' uses real Judge0 backend)
VITE_USE_MOCK_JUDGE=false